{
  "name": "vanscout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/run-with-env.mjs .env.staging next dev --hostname 0.0.0.0 --port 3100",
    "dev:staging": "node scripts/run-with-env.mjs .env.staging next dev --hostname 0.0.0.0 --port 3100",
    "build": "next build",
    "build:staging": "node scripts/run-with-env.mjs .env.staging next build",
    "build:production": "node scripts/run-with-env.mjs .env.production next build",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "start:staging": "node scripts/run-with-env.mjs .env.staging next start --hostname 0.0.0.0 --port 3100",
    "start:production": "node scripts/run-with-env.mjs .env.production next start --hostname 0.0.0.0 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@types/nodemailer": "^8.0.1",
    "ably": "^2.28.0",
    "firebase": "^12.19.0",
    "google-auth-library": "^10.5.0",
    "jose": "^6.1.0",
    "libphonenumber-js": "^1.13.13",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.12",
    "nodemailer": "^10.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.30.4",
    "stripe": "^22.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
