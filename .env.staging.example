# Staging/Preview environment. Use a separate Neon database from production.
DATABASE_URL=postgresql://user:password@staging-host/staging_database?sslmode=require

# Google Cloud Web client ID configured with the staging/preview origin.
GOOGLE_CLIENT_ID=your-staging-google-web-client-id.apps.googleusercontent.com

# Firebase Web app configuration for development/staging.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-firebase-web-app-id

# Keeps Spark-plan testing limited to Firebase fictional phone numbers.
FIREBASE_PHONE_TEST_MODE=true

# Generate a separate secret for staging; never reuse production JWT_SECRET.
JWT_SECRET=replace-with-a-staging-secret-at-least-32-characters

# Zoho SMTP settings used for password reset emails.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vanscout@zohomail.eu
SMTP_PASSWORD=your-zoho-app-password

# Stable public staging URL used in password reset links.
APP_URL=https://van-scout-git-staging-antonios-projects-d03311f7.vercel.app
