# Staging/Preview environment. Use a separate Neon database from production.
DATABASE_URL=postgresql://user:password@staging-host/staging_database?sslmode=require

# Google Cloud Web client ID configured with the staging/preview origin.
GOOGLE_CLIENT_ID=your-staging-google-web-client-id.apps.googleusercontent.com

# Generate a separate secret for staging; never reuse production JWT_SECRET.
JWT_SECRET=replace-with-a-staging-secret-at-least-32-characters
