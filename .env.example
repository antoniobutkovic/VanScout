# Neon/Postgres connection string used by the Next.js API routes.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Google Cloud OAuth 2.0 Web client ID. No Google client secret is required
# for the browser ID-token flow.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Firebase Web app configuration. These values identify the Firebase project
# in the browser and are not service-account secrets.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-firebase-web-app-id

# Use true only for local development with fictional test numbers configured
# in Firebase Authentication. Real SMS numbers will not work in this mode.
FIREBASE_PHONE_TEST_MODE=true

# At least 32 random characters. Keep this value private in Vercel.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Zoho SMTP settings used for password reset emails.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vanscout@zohomail.eu
SMTP_PASSWORD=your-zoho-app-password

# Public URL used in password reset links.
APP_URL=http://localhost:3100

# Geoapify server key used by the address search and reverse-geocoding routes.
# Keep this private; it must not be exposed as a NEXT_PUBLIC variable.
GEOAPIFY_API_KEY=your-geoapify-api-key
