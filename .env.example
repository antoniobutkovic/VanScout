# Neon/Postgres connection string used by the Next.js API routes.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Google Cloud OAuth 2.0 Web client ID. No Google client secret is required
# for the browser ID-token flow.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# At least 32 random characters. Keep this value private in Vercel.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Zoho SMTP settings used for password reset emails.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vanscout@zoho.eu
SMTP_PASSWORD=your-zoho-app-password
MAIL_FROM=vanscout@zoho.eu

# Public URL used in password reset links.
APP_URL=http://localhost:3100
