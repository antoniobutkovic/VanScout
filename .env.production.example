# Production environment. Use a separate protected Neon database.
DATABASE_URL=postgresql://user:password@production-host/production_database?sslmode=require

# Google Cloud Web client ID configured with the production origin.
GOOGLE_CLIENT_ID=your-production-google-web-client-id.apps.googleusercontent.com

# Generate a separate secret for production and keep it private.
JWT_SECRET=replace-with-a-production-secret-at-least-32-characters

# Zoho SMTP settings used for password reset emails.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vanscout@zoho.eu
SMTP_PASSWORD=your-zoho-app-password

# Public production URL used in password reset links.
APP_URL=https://your-production-domain.example
